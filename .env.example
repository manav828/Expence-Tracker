# ExpenCircle Environment Variables Example
# Pass these via --dart-define when compiling Flutter:
# flutter build web --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...

# Supabase Cloud Database & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Pixabay API (Cover photo searching)
PIXABAY_API_KEY=your_pixabay_api_key_here

# Cloudflare R2 Storage (Receipts & Cover Photos)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=your_bucket_name
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_PUBLIC_BASE_URL=https://pub-xxxxxx.r2.dev
