{
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/console/index.html"
    },
    {
      "source": "/membership",
      "destination": "/console/index.html"
    },
    {
      "source": "/((?!console/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/flutter_service_worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
